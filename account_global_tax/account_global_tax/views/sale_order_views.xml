<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add button to sale order form view -->
        <record id="sale_order_global_tax_button" model="ir.ui.view">
            <field name="name">sale.order.global.tax.button</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_global_tax_wizard"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calculator">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Impuestos Globales</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
