<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard form view -->
        <record id="global_tax_wizard_form" model="ir.ui.view">
            <field name="name">global.tax.wizard.form</field>
            <field name="model">global.tax.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <!-- Campos ocultos para filtrado -->
                    <field name="document_model" invisible="1"/>
                    <field name="document_id" invisible="1"/>
                    <field name="move_type" invisible="1"/>

                    <sheet>
                        <!-- Información de documento -->
                        <group colspan="4" col="4">
                            <field name="document_model" label="Tipo Documento" readonly="1" colspan="2"/>
                            <field name="total_lines" label="Líneas" readonly="1" widget="integer" colspan="2"/>
                        </group>

                        <!-- Impuestos seleccionados - Campo ancho -->
                        <group colspan="4" col="1">
                            <field name="global_tax_ids" widget="many2many_tags" colspan="1" nolabel="0" label="Selecciona Impuestos"/>
                        </group>

                        <!-- Contador de impuestos -->
                        <group colspan="4" col="4">
                            <field name="tax_count" label="Impuestos Seleccionados" readonly="1" widget="integer" colspan="4"/>
                        </group>
                    </sheet>

                    <footer>
                        <button name="action_apply_taxes"
                                type="object"
                                string="Aplicar Impuestos"
                                class="btn-primary"
                                attrs="{'invisible': [('tax_count', '=', 0)]}"/>
                        <button name="action_remove_taxes"
                                type="object"
                                string="Remover Impuestos"
                                class="btn-danger"
                                attrs="{'invisible': [('tax_count', '=', 0)]}"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard action -->
        <record id="global_tax_wizard_action" model="ir.actions.act_window">
            <field name="name">Global Tax Configuration</field>
            <field name="res_model">global.tax.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
