<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Batch Analysis Wizard Form View -->
        <record id="batch_analysis_wizard_form" model="ir.ui.view">
            <field name="name">batch.analysis.wizard.form</field>
            <field name="model">batch.analysis.wizard</field>
            <field name="arch" type="xml">
                <form string="Batch Financial Analysis Generator">
                    <group>
                        <group string="Analysis Settings">
                            <field name="period_type"/>
                            <field name="year"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Options">
                            <field name="include_budget_comparison"/>
                            <field name="include_previous_period"/>
                            <field name="generate_reports"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_generate_analyses" string="Generate Analyses" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Batch Analysis Wizard -->
        <record id="action_batch_analysis_wizard" model="ir.actions.act_window">
            <field name="name">Generate Batch Analyses</field>
            <field name="res_model">batch.analysis.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item for Batch Analysis -->
        <menuitem id="menu_batch_analysis" name="Generate Batch Analyses" parent="financial_analysis.menu_financial_analysis_root" action="action_batch_analysis_wizard" sequence="5"/>
    </data>
</odoo>
