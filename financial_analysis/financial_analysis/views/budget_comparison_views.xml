<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Budget Comparison Tree View -->
        <record id="budget_comparison_tree" model="ir.ui.view">
            <field name="name">budget.comparison.tree</field>
            <field name="model">budget.comparison</field>
            <field name="arch" type="xml">
                <tree string="Budget Comparison" decoration-success="status=='favorable'" decoration-danger="status=='unfavorable'">
                    <field name="account_name"/>
                    <field name="account_code"/>
                    <field name="line_type"/>
                    <field name="budget_amount" sum="Total"/>
                    <field name="actual_amount" sum="Total"/>
                    <field name="variance" sum="Total"/>
                    <field name="variance_pct"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <!-- Budget Comparison Form View -->
        <record id="budget_comparison_form" model="ir.ui.view">
            <field name="name">budget.comparison.form</field>
            <field name="model">budget.comparison</field>
            <field name="arch" type="xml">
                <form string="Budget Comparison">
                    <sheet>
                        <group>
                            <group string="Account Information">
                                <field name="account_code"/>
                                <field name="account_name"/>
                                <field name="line_type"/>
                            </group>
                            <group string="Status">
                                <field name="status" decoration-success="status=='favorable'" decoration-danger="status=='unfavorable'"/>
                            </group>
                        </group>

                        <group>
                            <group string="Budget Data">
                                <field name="budget_amount" widget="monetary"/>
                            </group>
                            <group string="Actual Data">
                                <field name="actual_amount" widget="monetary"/>
                            </group>
                        </group>

                        <group>
                            <group string="Variance Analysis">
                                <field name="variance" widget="monetary"/>
                                <field name="variance_pct" widget="float" precision="2"/>
                            </group>
                        </group>

                        <field name="notes" nolabel="1" placeholder="Add notes about this variance..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Budget Comparison Search View -->
        <record id="budget_comparison_search" model="ir.ui.view">
            <field name="name">budget.comparison.search</field>
            <field name="model">budget.comparison</field>
            <field name="arch" type="xml">
                <search string="Budget Comparison">
                    <field name="account_name" string="Account"/>
                    <field name="account_code"/>
                    <filter string="Revenue" name="revenue" domain="[('line_type','=','revenue')]"/>
                    <filter string="Costs" name="costs" domain="[('line_type','=','cost')]"/>
                    <filter string="Expenses" name="expenses" domain="[('line_type','=','expense')]"/>
                    <separator/>
                    <filter string="On Target" name="on_target" domain="[('status','=','on_target')]"/>
                    <filter string="Favorable" name="favorable" domain="[('status','=','favorable')]"/>
                    <filter string="Unfavorable" name="unfavorable" domain="[('status','=','unfavorable')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Type" name="type" context="{'group_by':'line_type'}"/>
                        <filter string="Status" name="status" context="{'group_by':'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Budget Comparison Action -->
        <record id="action_budget_comparison" model="ir.actions.act_window">
            <field name="name">Budget vs Actual Comparison</field>
            <field name="res_model">budget.comparison</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="budget_comparison_search"/>
        </record>
    </data>
</odoo>
