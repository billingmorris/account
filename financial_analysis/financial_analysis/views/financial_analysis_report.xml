<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financial Analysis Summary Report Template -->
        <template id="financial_analysis_report_template">
            <t t-call="web.html_container">
                <t t-set="doc" t-value="docs[0]"/>
                <div class="article o_report_layout_standard">
                    <!-- Header -->
                    <div class="page" style="page-break-after: always;">
                        <h1 class="text-center mb-4">
                            <t t-esc="doc.name"/>
                        </h1>
                        <h4 class="text-center text-muted">
                            <t t-esc="doc.company_id.name"/>
                        </h4>

                        <table class="table table-sm border-top border-bottom mt-4">
                            <tr>
                                <td><strong>Analysis Period:</strong></td>
                                <td>
                                    <t t-esc="doc.start_date.strftime('%d/%m/%Y')"/>
                                    to
                                    <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Analysis Date:</strong></td>
                                <td><t t-esc="doc.analysis_date.strftime('%d/%m/%Y')"/></td>
                            </tr>
                            <tr>
                                <td><strong>Overall Health Status:</strong></td>
                                <td>
                                    <span t-attf-class="badge badge-lg {{
                                        'badge-success' if doc.overall_health == 'Excellent' else
                                        'badge-info' if doc.overall_health == 'Good' else
                                        'badge-warning' if doc.overall_health == 'Fair' else
                                        'badge-danger'
                                    }}">
                                        <t t-esc="doc.overall_health"/>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Health Score:</strong></td>
                                <td><t t-esc="doc.health_score"/> / 100</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Executive Summary -->
                    <div class="page" style="page-break-after: always;">
                        <h2>Executive Summary</h2>
                        <hr/>

                        <h4>Key Financial Metrics</h4>
                        <table class="table table-bordered table-sm">
                            <thead class="bg-light">
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-right">Value</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Total Revenue</td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></td>
                                    <td><span class="badge badge-success">✓</span></td>
                                </tr>
                                <tr>
                                    <td>Net Income</td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.net_income)"/></td>
                                    <td>
                                        <span t-if="doc.net_income &gt; 0" class="badge badge-success">Profit</span>
                                        <span t-else="" class="badge badge-danger">Loss</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Net Margin</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td>
                                    <td>
                                        <span t-if="doc.net_margin &gt;= 15" class="badge badge-success">Excellent</span>
                                        <span t-elif="doc.net_margin &gt;= 8" class="badge badge-info">Good</span>
                                        <span t-elif="doc.net_margin &gt;= 2" class="badge badge-warning">Fair</span>
                                        <span t-else="" class="badge badge-danger">Poor</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Current Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.current_ratio)"/></td>
                                    <td>
                                        <span t-if="doc.current_ratio &gt;= 1.5" class="badge badge-success">Good Liquidity</span>
                                        <span t-elif="doc.current_ratio &gt;= 1" class="badge badge-info">Adequate</span>
                                        <span t-else="" class="badge badge-danger">Risk</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Debt/Equity Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/></td>
                                    <td>
                                        <span t-if="doc.debt_to_equity &lt;= 0.5" class="badge badge-success">Low Leverage</span>
                                        <span t-elif="doc.debt_to_equity &lt;= 1.0" class="badge badge-info">Balanced</span>
                                        <span t-else="" class="badge badge-danger">High Leverage</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROE</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roe)"/></td>
                                    <td>
                                        <span t-if="doc.roe &gt;= 20" class="badge badge-success">Excellent</span>
                                        <span t-elif="doc.roe &gt;= 10" class="badge badge-info">Good</span>
                                        <span t-else="" class="badge badge-warning">Fair</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Income Statement Analysis -->
                    <div class="page" style="page-break-after: always;">
                        <h2>Income Statement Analysis</h2>
                        <hr/>

                        <h4>Revenue &amp; Profitability</h4>
                        <table class="table table-bordered table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>Total Revenue</strong></td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></td>
                                </tr>
                                <tr class="table-light">
                                    <td>Cost of Goods Sold</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.cost_of_goods_sold)"/>)</td>
                                </tr>
                                <tr class="table-info">
                                    <td><strong>Gross Profit</strong></td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.gross_profit)"/></td>
                                </tr>
                                <tr>
                                    <td>Gross Margin %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.gross_margin)"/></td>
                                </tr>
                                <tr class="table-light">
                                    <td>Operating Expenses</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.operating_expenses)"/>)</td>
                                </tr>
                                <tr class="table-info">
                                    <td><strong>Operating Profit</strong></td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.operating_profit)"/></td>
                                </tr>
                                <tr>
                                    <td>Operating Margin %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.operating_margin)"/></td>
                                </tr>
                                <tr class="table-success">
                                    <td><strong>Net Income</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.net_income)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Net Margin %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Balance Sheet Analysis -->
                    <div class="page" style="page-break-after: always;">
                        <h2>Balance Sheet Analysis</h2>
                        <hr/>

                        <div class="row">
                            <div class="col-md-6">
                                <h4>Assets</h4>
                                <table class="table table-bordered table-sm">
                                    <tbody>
                                        <tr class="table-light">
                                            <td>Current Assets</td>
                                            <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.current_assets)"/></td>
                                        </tr>
                                        <tr class="table-light">
                                            <td>Fixed Assets</td>
                                            <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.fixed_assets)"/></td>
                                        </tr>
                                        <tr class="table-success">
                                            <td><strong>Total Assets</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.total_assets)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h4>Liabilities &amp; Equity</h4>
                                <table class="table table-bordered table-sm">
                                    <tbody>
                                        <tr class="table-light">
                                            <td>Current Liabilities</td>
                                            <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.current_liabilities)"/></td>
                                        </tr>
                                        <tr class="table-light">
                                            <td>Long Term Liabilities</td>
                                            <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.long_term_liabilities)"/></td>
                                        </tr>
                                        <tr class="table-warning">
                                            <td><strong>Total Liabilities</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.total_liabilities)"/></strong></td>
                                        </tr>
                                        <tr class="table-info">
                                            <td><strong>Total Equity</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.total_equity)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Indicators with Explanations -->
                    <div class="page" style="page-break-after: always;">
                        <h2>Financial Indicators with Explanations</h2>
                        <hr/>

                        <t t-foreach="doc.indicator_ids" t-as="indicator">
                            <div class="mb-4 p-3 border rounded">
                                <h5>
                                    <t t-esc="indicator.name"/>
                                    <span t-attf-class="float-right badge {{
                                        'badge-success' if indicator.status == 'excellent' else
                                        'badge-info' if indicator.status == 'good' else
                                        'badge-warning' if indicator.status == 'fair' else
                                        'badge-danger'
                                    }}">
                                        <t t-esc="indicator.status.upper()"/>
                                    </span>
                                </h5>
                                <p><strong>Current Value:</strong> <t t-esc="'{:.2f}'.format(indicator.value)"/> <t t-esc="indicator.unit or ''"/></p>

                                <p t-if="indicator.legend_formula"><strong>Formula:</strong> <t t-esc="indicator.legend_formula"/></p>

                                <p t-if="indicator.legend_description" class="mt-2">
                                    <strong>What it Measures:</strong><br/>
                                    <t t-esc="indicator.legend_description"/>
                                </p>

                                <p t-if="indicator.legend_interpretation" class="mt-2">
                                    <strong>Your Score Interpretation:</strong><br/>
                                    <t t-esc="indicator.legend_interpretation"/>
                                </p>

                                <p t-if="indicator.legend_improvement" class="mt-2">
                                    <strong>How to Improve:</strong><br/>
                                    <pre style="background-color: #f5f5f5; padding: 10px; border-radius: 4px;"><t t-esc="indicator.legend_improvement"/></pre>
                                </p>
                            </div>
                        </t>
                    </div>

                    <!-- Diagnostics and Recommendations -->
                    <div class="page">
                        <h2>Diagnostics &amp; Recommendations</h2>
                        <hr/>

                        <h4 class="mt-4">Key Diagnostics</h4>
                        <t t-if="doc.diagnostic_ids">
                            <t t-foreach="doc.diagnostic_ids" t-as="diagnostic">
                                <div class="mb-3 p-2 border-left-3" t-attf-style="border-left-color: {{
                                    '#28a745' if diagnostic.severity == 'low' else
                                    '#ffc107' if diagnostic.severity == 'medium' else
                                    '#fd7e14' if diagnostic.severity == 'high' else
                                    '#dc3545'
                                }};">
                                    <p><strong><t t-esc="diagnostic.name"/></strong>
                                        <span t-attf-class="badge {{
                                            'badge-success' if diagnostic.severity == 'low' else
                                            'badge-warning' if diagnostic.severity == 'medium' else
                                            'badge-orange' if diagnostic.severity == 'high' else
                                            'badge-danger'
                                        }}">
                                            <t t-esc="diagnostic.severity.upper()"/>
                                        </span>
                                    </p>
                                    <p t-if="diagnostic.description"><t t-esc="diagnostic.description"/></p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No diagnostics available.</p>
                        </t>

                        <h4 class="mt-4">Recommendations</h4>
                        <t t-if="doc.recommendation_ids">
                            <t t-foreach="doc.recommendation_ids" t-as="recommendation">
                                <div class="mb-3 p-2 bg-light border rounded">
                                    <p><strong><t t-esc="recommendation.name"/></strong>
                                        <span t-attf-class="badge {{
                                            'badge-danger' if recommendation.priority == 'urgent' else
                                            'badge-warning' if recommendation.priority == 'high' else
                                            'badge-info' if recommendation.priority == 'medium' else
                                            'badge-success'
                                        }}">
                                            <t t-esc="recommendation.priority.upper()"/>
                                        </span>
                                    </p>
                                    <p t-if="recommendation.description"><t t-esc="recommendation.description"/></p>
                                    <p t-if="recommendation.estimated_benefit" class="text-success"><strong>Expected Benefit:</strong> <t t-esc="recommendation.expected_impact"/></p>
                                    <p t-if="recommendation.roi" class="text-info"><strong>Estimated ROI:</strong> <t t-esc="'{:.1f}%'.format(recommendation.roi)"/></p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No recommendations available.</p>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_financial_analysis_report" model="ir.actions.report">
            <field name="name">Financial Analysis Report</field>
            <field name="model">financial.analysis</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_analysis.financial_analysis_report_template</field>
            <field name="print_report_name">'Financial Analysis Report - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
