<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Simple Financial Analysis Report Template -->
        <template id="financial_analysis_report_template">
            <t t-call="web.html_container">
                <t t-set="doc" t-value="docs[0]"/>
                <div class="article o_report_layout_standard" style="font-size: 12pt; line-height: 1.6;">
                    <!-- Header -->
                    <div class="page" style="page-break-after: always;">
                        <h1 class="text-center mb-4" style="font-size: 28pt;"><t t-esc="doc.name"/></h1>
                        <h4 class="text-center text-muted" style="font-size: 16pt;"><t t-esc="doc.company_id.name"/></h4>

                        <table class="table border-top border-bottom mt-4" style="font-size: 12pt;">
                            <tr>
                                <td><strong>Period:</strong></td>
                                <td><t t-esc="doc.start_date.strftime('%d/%m/%Y')"/> to <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/></td>
                            </tr>
                            <tr>
                                <td><strong>Overall Health:</strong></td>
                                <td><strong><t t-esc="doc.overall_health"/></strong> (Score: <t t-esc="'{:.0f}'.format(doc.health_score)"/>/100)</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Executive Summary -->
                    <div class="page" style="page-break-after: always;">
                        <h2 style="font-size: 20pt;">Executive Summary</h2>
                        <hr/>

                        <h4 style="font-size: 14pt;">Key Financial Metrics</h4>
                        <table class="table table-bordered" style="font-size: 12pt;">
                            <thead class="bg-light">
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-right">Value</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Total Revenue</td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></td>
                                    <td>✓</td>
                                </tr>
                                <tr>
                                    <td>Net Income</td>
                                    <td class="text-right"><t t-esc="'{:,.2f}'.format(doc.net_income)"/></td>
                                    <td><t t-if="doc.net_income &gt; 0">Profit ✓</t><t t-else="">Loss ✗</t></td>
                                </tr>
                                <tr>
                                    <td>Net Margin %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td>
                                    <td>
                                        <t t-if="doc.net_margin &gt;= 15">Excellent ✓✓</t>
                                        <t t-elif="doc.net_margin &gt;= 8">Good ✓</t>
                                        <t t-elif="doc.net_margin &gt;= 2">Fair ⚠</t>
                                        <t t-else="">Poor ✗</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Current Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.current_ratio)"/></td>
                                    <td>
                                        <t t-if="doc.current_ratio &gt;= 1.5">Good Liquidity ✓</t>
                                        <t t-elif="doc.current_ratio &gt;= 1">Adequate ⚠</t>
                                        <t t-else="">Risk ✗</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Debt/Equity Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/></td>
                                    <td>
                                        <t t-if="doc.debt_to_equity &lt;= 0.5">Low Leverage ✓</t>
                                        <t t-elif="doc.debt_to_equity &lt;= 1.0">Balanced ✓</t>
                                        <t t-else="">High Leverage ✗</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROE %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roe)"/></td>
                                    <td>
                                        <t t-if="doc.roe &gt;= 20">Excellent ✓✓</t>
                                        <t t-elif="doc.roe &gt;= 10">Good ✓</t>
                                        <t t-else="">Fair ⚠</t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Income Statement -->
                    <div class="page" style="page-break-after: always;">
                        <h2 style="font-size: 20pt;">Income Statement Analysis</h2>
                        <hr/>

                        <table class="table table-bordered" style="font-size: 12pt;">
                            <tbody>
                                <tr><td><strong>Total Revenue</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></td></tr>
                                <tr class="table-light"><td>Cost of Goods Sold</td><td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.cost_of_goods_sold)"/>)</td></tr>
                                <tr class="table-info"><td><strong>Gross Profit</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.gross_profit)"/></td></tr>
                                <tr><td>Gross Margin %</td><td class="text-right"><t t-esc="'{:.2f}%'.format(doc.gross_margin)"/></td></tr>
                                <tr class="table-light"><td>Operating Expenses</td><td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.operating_expenses)"/>)</td></tr>
                                <tr class="table-info"><td><strong>Operating Profit</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.operating_profit)"/></td></tr>
                                <tr><td>Operating Margin %</td><td class="text-right"><t t-esc="'{:.2f}%'.format(doc.operating_margin)"/></td></tr>
                                <tr class="table-success"><td><strong>Net Income</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.net_income)"/></td></tr>
                                <tr><td>Net Margin %</td><td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td></tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Balance Sheet -->
                    <div class="page" style="page-break-after: always;">
                        <h2 style="font-size: 20pt;">Balance Sheet Analysis</h2>
                        <hr/>

                        <div class="row">
                            <div class="col-md-6">
                                <h4 style="font-size: 14pt;">Assets</h4>
                                <table class="table table-bordered" style="font-size: 12pt;">
                                    <tbody>
                                        <tr><td>Current Assets</td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.current_assets)"/></td></tr>
                                        <tr><td>Fixed Assets</td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.fixed_assets)"/></td></tr>
                                        <tr class="table-success"><td><strong>Total Assets</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_assets)"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h4 style="font-size: 14pt;">Liabilities &amp; Equity</h4>
                                <table class="table table-bordered" style="font-size: 12pt;">
                                    <tbody>
                                        <tr><td>Current Liabilities</td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.current_liabilities)"/></td></tr>
                                        <tr><td>Long Term Liabilities</td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.long_term_liabilities)"/></td></tr>
                                        <tr class="table-warning"><td><strong>Total Liabilities</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_liabilities)"/></td></tr>
                                        <tr class="table-info"><td><strong>Total Equity</strong></td><td class="text-right"><t t-esc="'{:,.2f}'.format(doc.total_equity)"/></td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Indicators -->
                    <div class="page" style="page-break-after: always;">
                        <h2 style="font-size: 20pt;">Financial Indicators Analysis</h2>
                        <hr/>

                        <t t-foreach="doc.indicator_ids" t-as="indicator">
                            <div class="mb-4 p-3 border rounded" style="page-break-inside: avoid;">
                                <h5 style="font-size: 13pt;"><t t-esc="indicator.name"/> - <t t-esc="indicator.category.upper()"/></h5>
                                <p><strong>Current Value:</strong> <t t-esc="'{:.2f}'.format(indicator.value)"/> <t t-esc="indicator.unit or ''"/></p>

                                <div style="background-color: #f9f9f9; padding: 10px; margin: 10px 0; border-left: 3px solid #0066cc;">
                                    <p><strong>Status:</strong>
                                        <t t-if="indicator.status == 'excellent'">✓✓ EXCELLENT</t>
                                        <t t-elif="indicator.status == 'good'">✓ GOOD</t>
                                        <t t-elif="indicator.status == 'fair'">⚠ FAIR</t>
                                        <t t-else="">✗ NEEDS IMPROVEMENT</t>
                                    </p>
                                    <p><strong>What it measures:</strong> This indicator measures the company's <t t-esc="indicator.category"/> performance.</p>
                                    <p><strong>Interpretation:</strong>
                                        <t t-if="indicator.category == 'profitability'">
                                            <t t-if="indicator.status == 'excellent'">Your company is generating excellent profits with strong margins.</t>
                                            <t t-elif="indicator.status == 'good'">Your company has good profitability. Look for ways to improve margins.</t>
                                            <t t-elif="indicator.status == 'fair'">Your profit margins are modest. Focus on cost reduction and revenue growth.</t>
                                            <t t-else="">Your company is not profitable. Urgent action needed to improve operations.</t>
                                        </t>
                                        <t t-elif="indicator.category == 'liquidity'">
                                            <t t-if="indicator.status == 'excellent'">Your company has strong liquidity and can easily meet short-term obligations.</t>
                                            <t t-elif="indicator.status == 'good'">Your liquidity position is solid with adequate current assets.</t>
                                            <t t-elif="indicator.status == 'fair'">Your liquidity is adequate but monitor closely. Improve working capital.</t>
                                            <t t-else="">Your company may have difficulty paying short-term obligations. Take immediate action.</t>
                                        </t>
                                        <t t-elif="indicator.category == 'leverage'">
                                            <t t-if="indicator.status == 'excellent'">Your company has low financial risk with minimal debt.</t>
                                            <t t-elif="indicator.status == 'good'">Your debt levels are manageable with balanced financing.</t>
                                            <t t-elif="indicator.status == 'fair'">Your company has moderate debt. Consider debt reduction strategies.</t>
                                            <t t-else="">Your company has high debt levels with increased financial risk. Reduce debt urgently.</t>
                                        </t>
                                        <t t-elif="indicator.category == 'efficiency'">
                                            <t t-if="indicator.status == 'excellent'">Your company uses assets very efficiently to generate sales.</t>
                                            <t t-elif="indicator.status == 'good'">Your asset utilization is good. Continue optimizing operations.</t>
                                            <t t-elif="indicator.status == 'fair'">Your asset utilization is moderate. Improve efficiency.</t>
                                            <t t-else="">Your company has underutilized assets. Improve efficiency or reduce assets.</t>
                                        </t>
                                    </p>
                                </div>

                                <div style="background-color: #d4edda; padding: 10px; margin: 10px 0; border-left: 3px solid #28a745;">
                                    <p><strong>How to Improve:</strong></p>
                                    <ul style="margin-left: 20px;">
                                        <t t-if="indicator.category == 'profitability'">
                                            <li>Reduce operating costs through efficiency improvements</li>
                                            <li>Increase sales volume or prices</li>
                                            <li>Optimize production/service delivery processes</li>
                                            <li>Review and eliminate non-essential expenses</li>
                                        </t>
                                        <t t-elif="indicator.category == 'liquidity'">
                                            <li>Accelerate collection of customer receivables</li>
                                            <li>Negotiate longer payment terms with suppliers</li>
                                            <li>Reduce excess inventory</li>
                                            <li>Secure additional credit lines if needed</li>
                                        </t>
                                        <t t-elif="indicator.category == 'leverage'">
                                            <li>Increase retained earnings through profits</li>
                                            <li>Pay down existing debt with cash flow</li>
                                            <li>Refinance at better rates</li>
                                            <li>Raise additional equity capital</li>
                                        </t>
                                        <t t-elif="indicator.category == 'efficiency'">
                                            <li>Increase sales without adding assets</li>
                                            <li>Eliminate or sell underutilized assets</li>
                                            <li>Improve inventory turnover</li>
                                            <li>Optimize asset allocation</li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Recommendations Page -->
                    <div class="page">
                        <h2 style="font-size: 20pt;">Recommendations &amp; Action Plan</h2>
                        <hr/>

                        <t t-if="doc.recommendation_ids">
                            <t t-foreach="doc.recommendation_ids" t-as="rec">
                                <div class="mb-3 p-2 border rounded" style="page-break-inside: avoid;">
                                    <p><strong><t t-esc="rec.name"/></strong>
                                        <span style="background-color: #ffc107; padding: 2px 8px; border-radius: 3px; font-size: 11px;">
                                            <t t-esc="rec.priority.upper()"/>
                                        </span>
                                    </p>
                                    <p><t t-esc="rec.description or 'No description available'"/></p>
                                    <p t-if="rec.estimated_benefit"><strong>Expected Impact:</strong> <t t-esc="rec.expected_impact"/></p>
                                    <p t-if="rec.roi"><strong>Estimated ROI:</strong> <t t-esc="'{:.1f}%'.format(rec.roi)"/></p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No recommendations available at this time.</p>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_financial_analysis_report" model="ir.actions.report">
            <field name="name">Financial Analysis Report</field>
            <field name="model">financial.analysis</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_analysis.financial_analysis_report_template</field>
            <field name="print_report_name">'Financial Analysis Report - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
