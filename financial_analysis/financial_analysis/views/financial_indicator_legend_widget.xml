<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financial Indicator Form View with Legend Display -->
        <record id="financial_indicator_form_with_legend" model="ir.ui.view">
            <field name="name">financial.indicator.form.with.legend</field>
            <field name="model">financial.indicator</field>
            <field name="arch" type="xml">
                <form string="Financial Indicator with Legend">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="excellent,good,fair,poor"/>
                    </header>
                    <sheet>
                        <div class="row">
                            <div class="col-md-8">
                                <h2>
                                    <field name="name"/>
                                </h2>
                                <group>
                                    <group string="Basic Information">
                                        <field name="analysis_id"/>
                                        <field name="category"/>
                                        <field name="value"/>
                                        <field name="unit"/>
                                    </group>
                                    <group string="Comparison">
                                        <field name="benchmark"/>
                                        <field name="variance"/>
                                    </group>
                                </group>
                            </div>
                            <div class="col-md-4">
                                <div class="alert alert-info">
                                    <strong>Indicator Status:</strong>
                                    <field name="status" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <notebook>
                            <page string="Legend &amp; Guide" name="legend_guide">
                                <group string="Formula" col="1">
                                    <field name="legend_id" nolabel="1" readonly="1" widget="reference"/>
                                </group>

                                <separator string="How to Calculate"/>
                                <group col="1">
                                    <field name="legend_formula" nolabel="1" readonly="1" placeholder="Formula will appear here"/>
                                </group>

                                <separator string="What Does This Indicator Measure?"/>
                                <group col="1">
                                    <field name="legend_description" nolabel="1" readonly="1" placeholder="Description will appear here"/>
                                </group>

                                <separator string="Interpretation of Your Score"/>
                                <div class="alert alert-warning" role="alert">
                                    <field name="legend_interpretation" nolabel="1" readonly="1" placeholder="Interpretation will appear here"/>
                                </div>

                                <separator string="How to Improve"/>
                                <group col="1">
                                    <field name="legend_improvement" nolabel="1" readonly="1" placeholder="Improvement tips will appear here"/>
                                </group>
                            </page>

                            <page string="Details" name="details">
                                <group col="1">
                                    <field name="description" nolabel="1" placeholder="Additional notes about this indicator..."/>
                                </group>
                                <separator string="System Notes"/>
                                <group col="1">
                                    <field name="notes" nolabel="1" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
