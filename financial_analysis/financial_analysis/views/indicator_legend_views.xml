<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Indicator Legend Tree View -->
        <record id="indicator_legend_tree" model="ir.ui.view">
            <field name="name">indicator.legend.tree</field>
            <field name="model">indicator.legend</field>
            <field name="arch" type="xml">
                <tree string="Indicator Legends">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="unit"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Indicator Legend Form View -->
        <record id="indicator_legend_form" model="ir.ui.view">
            <field name="name">indicator.legend.form</field>
            <field name="model">indicator.legend</field>
            <field name="arch" type="xml">
                <form string="Indicator Legend">
                    <sheet>
                        <h1>
                            <field name="name" placeholder="Indicator Name"/>
                        </h1>

                        <group>
                            <group string="Basic Information">
                                <field name="code"/>
                                <field name="category"/>
                                <field name="unit"/>
                                <field name="active"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Definition" name="definition">
                                <group string="Formula">
                                    <field name="formula" nolabel="1" placeholder="Ej: Ganancia Neta / Ingresos Totales × 100"/>
                                </group>
                                <group string="Description">
                                    <field name="description" nolabel="1" placeholder="What does this indicator measure and why is it important?"/>
                                </group>
                            </page>

                            <page string="Ranges" name="ranges">
                                <group string="Excellent Range">
                                    <field name="excellent_min"/>
                                    <field name="excellent_max"/>
                                    <field name="excellent_description" nolabel="1"/>
                                </group>

                                <group string="Good Range">
                                    <field name="good_min"/>
                                    <field name="good_max"/>
                                    <field name="good_description" nolabel="1"/>
                                </group>

                                <group string="Fair Range">
                                    <field name="fair_min"/>
                                    <field name="fair_max"/>
                                    <field name="fair_description" nolabel="1"/>
                                </group>

                                <group string="Poor Range">
                                    <field name="poor_min"/>
                                    <field name="poor_max"/>
                                    <field name="poor_description" nolabel="1"/>
                                </group>
                            </page>

                            <page string="Improvement" name="improvement">
                                <group string="How to Improve This Indicator">
                                    <field name="improvement_tips" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Indicator Legend Search View -->
        <record id="indicator_legend_search" model="ir.ui.view">
            <field name="name">indicator.legend.search</field>
            <field name="model">indicator.legend</field>
            <field name="arch" type="xml">
                <search string="Indicator Legends">
                    <field name="name" string="Legend"/>
                    <field name="code"/>
                    <filter string="Profitability" name="profitability" domain="[('category','=','profitability')]"/>
                    <filter string="Liquidity" name="liquidity" domain="[('category','=','liquidity')]"/>
                    <filter string="Leverage" name="leverage" domain="[('category','=','leverage')]"/>
                    <filter string="Efficiency" name="efficiency" domain="[('category','=','efficiency')]"/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="category" context="{'group_by':'category'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Indicator Legend Action -->
        <record id="action_indicator_legend" model="ir.actions.act_window">
            <field name="name">Indicator Legends</field>
            <field name="res_model">indicator.legend</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="indicator_legend_search"/>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
