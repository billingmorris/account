<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financial Analysis Report Template - Enhanced with Detailed Indicators -->
        <template id="financial_analysis_report_template">
            <t t-call="web.html_container">
                <t t-set="doc" t-value="docs[0]"/>
                <div class="article o_report_layout_standard" style="font-size: 11pt; line-height: 1.4; margin: 0; padding: 0;">
                    <style>
                        .report-header { background-color: #1a472a; color: white; padding: 15px; margin: -15px -15px 0 -15px; }
                        .report-title { font-size: 24pt; font-weight: bold; margin: 0; }
                        .report-subtitle { font-size: 13pt; opacity: 0.9; margin-top: 3px; }
                        .report-company { font-size: 12pt; margin-top: 8px; }

                        .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 10px 0; }
                        .metric-item { background-color: #f0f0f0; padding: 6px 8px; border-left: 3px solid #1a472a; }
                        .metric-label { font-size: 10pt; color: #666; }
                        .metric-value { font-size: 12pt; font-weight: bold; color: #000; }

                        .section-title { font-size: 14pt; font-weight: bold; color: #1a472a; margin-top: 12px; margin-bottom: 6px; border-bottom: 2px solid #1a472a; padding-bottom: 4px; }

                        .table-compact { width: 100%; border-collapse: collapse; font-size: 10.5pt; margin: 8px 0; }
                        .table-compact th { background-color: #2a5a40; color: white; padding: 5px 6px; text-align: left; font-weight: bold; border: none; }
                        .table-compact td { padding: 4px 6px; border-bottom: 1px solid #ddd; }
                        .table-compact tr:nth-child(even) { background-color: #f9f9f9; }
                        .table-compact tr:hover { background-color: #f0f0f0; }

                        .text-right { text-align: right; }
                        .text-center { text-align: center; }

                        .highlight-row { background-color: #e8f4f0; font-weight: bold; }
                        .highlight-positive { color: #28a745; }
                        .highlight-negative { color: #dc3545; }

                        .key-metric-box { display: inline-block; background: linear-gradient(135deg, #1a472a 0%, #2a5a40 100%); color: white; padding: 8px 12px; margin: 4px 2px; border-radius: 4px; text-align: center; min-width: 120px; }
                        .key-metric-box-label { font-size: 9pt; opacity: 0.9; }
                        .key-metric-box-value { font-size: 13pt; font-weight: bold; }

                        .indicator-card { background-color: #f8f9fa; border-left: 4px solid #1a472a; padding: 10px; margin: 8px 0; page-break-inside: avoid; }
                        .indicator-name { font-size: 11pt; font-weight: bold; color: #000; }
                        .indicator-acronym { font-size: 9pt; color: #1a472a; font-weight: bold; background-color: #e8f4f0; padding: 1px 4px; border-radius: 2px; display: inline-block; margin-left: 6px; }
                        .indicator-value { font-size: 13pt; color: #1a472a; font-weight: bold; }
                        .indicator-status { font-size: 9pt; display: inline-block; padding: 2px 6px; border-radius: 3px; margin-left: 5px; }
                        .status-excellent { background-color: #28a745; color: white; }
                        .status-good { background-color: #4CAF50; color: white; }
                        .status-fair { background-color: #ff9800; color: white; }
                        .status-poor { background-color: #dc3545; color: white; }

                        .page-break { page-break-after: always; padding-bottom: 20px; }

                        .recommendation { background-color: #e8f4f0; border-left: 3px solid #1a472a; padding: 8px; margin: 6px 0; font-size: 10.5pt; page-break-inside: avoid; }

                        .analysis-box { background-color: #f0f8f4; border-left: 3px solid #28a745; padding: 8px; margin: 8px 0; font-size: 9.5pt; line-height: 1.5; }

                        h1, h2, h3, h4, h5 { margin: 0; padding: 0; }
                    </style>

                    <!-- PAGE 1: HEADER & DASHBOARD -->
                    <div class="page-break">
                        <div class="report-header">
                            <div class="report-title"><t t-esc="doc.name"/></div>
                            <div class="report-company"><t t-esc="doc.company_id.name"/></div>
                            <div class="report-subtitle">Reporte de Análisis Financiero</div>
                        </div>

                        <div class="metrics-grid" style="margin-top: 15px;">
                            <div class="metric-item">
                                <div class="metric-label">Período</div>
                                <div class="metric-value"><t t-esc="doc.start_date.strftime('%d/%m/%Y')"/> al <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/></div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Salud Financiera</div>
                                <div class="metric-value"><t t-esc="doc.overall_health"/> (<t t-esc="'{:.0f}'.format(doc.health_score)"/>/100)</div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Tipo de Análisis</div>
                                <div class="metric-value">
                                    <t t-if="doc.analysis_type == 'monthly'">Mensual</t>
                                    <t t-elif="doc.analysis_type == 'quarterly'">Trimestral</t>
                                    <t t-elif="doc.analysis_type == 'semiannual'">Semestral</t>
                                    <t t-elif="doc.analysis_type == 'annual'">Anual</t>
                                    <t t-else=""><t t-esc="doc.analysis_type.title()"/></t>
                                </div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Fecha del Análisis</div>
                                <div class="metric-value"><t t-esc="doc.analysis_date.strftime('%d/%m/%Y')"/></div>
                            </div>
                        </div>

                        <div class="section-title" style="margin-top: 20px;">Indicadores Clave de Rentabilidad</div>
                        <div style="margin: 10px 0;">
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Ingresos Totales</div>
                                <div class="key-metric-box-value"><t t-esc="'{:,.0f}'.format(doc.total_revenue)"/></div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Ingreso Neto</div>
                                <div class="key-metric-box-value" t-attf-style="color: {('white' if doc.net_income > 0 else '#ff6b6b')};">
                                    <t t-esc="'{:,.0f}'.format(doc.net_income)"/>
                                </div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Margen Neto</div>
                                <div class="key-metric-box-value"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">ROE</div>
                                <div class="key-metric-box-value"><t t-esc="'{:.1f}%'.format(doc.roe)"/></div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">ROA</div>
                                <div class="key-metric-box-value"><t t-esc="'{:.1f}%'.format(doc.roa)"/></div>
                            </div>
                        </div>

                        <div class="section-title" style="margin-top: 15px;">Resumen Ejecutivo - Métricas Clave</div>
                        <table class="table-compact">
                            <thead>
                                <tr>
                                    <th>Métrica</th>
                                    <th class="text-right">Valor Actual</th>
                                    <th class="text-right">Meta</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="highlight-row">
                                    <td><strong>Ingresos Totales</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_revenue)"/></strong></td>
                                    <td class="text-right">—</td>
                                    <td class="text-center">✓</td>
                                </tr>
                                <tr>
                                    <td>Margen Neto %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td>
                                    <td class="text-right">15%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.net_margin &gt;= 15"><span style="color: #28a745;">✓ Excelente</span></t>
                                        <t t-elif="doc.net_margin &gt;= 8"><span style="color: #4CAF50;">✓ Bueno</span></t>
                                        <t t-elif="doc.net_margin &gt;= 2"><span style="color: #ff9800;">⚠ Regular</span></t>
                                        <t t-else=""><span style="color: #dc3545;">✗ Deficiente</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Razón Corriente</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.current_ratio)"/></td>
                                    <td class="text-right">1.5+</td>
                                    <td class="text-center">
                                        <t t-if="doc.current_ratio &gt;= 1.5"><span style="color: #28a745;">✓ Buena</span></t>
                                        <t t-elif="doc.current_ratio &gt;= 1"><span style="color: #ff9800;">⚠ Adecuada</span></t>
                                        <t t-else=""><span style="color: #dc3545;">✗ Riesgo</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Razón Deuda/Patrimonio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/></td>
                                    <td class="text-right">&lt; 1.0</td>
                                    <td class="text-center">
                                        <t t-if="doc.debt_to_equity &lt;= 0.5"><span style="color: #28a745;">✓ Bajo</span></t>
                                        <t t-elif="doc.debt_to_equity &lt;= 1.0"><span style="color: #4CAF50;">✓ Balanceado</span></t>
                                        <t t-else=""><span style="color: #dc3545;">✗ Alto</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROE %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roe)"/></td>
                                    <td class="text-right">20%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.roe &gt;= 20"><span style="color: #28a745;">✓ Excelente</span></t>
                                        <t t-elif="doc.roe &gt;= 10"><span style="color: #4CAF50;">✓ Bueno</span></t>
                                        <t t-else=""><span style="color: #ff9800;">⚠ Regular</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROA %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roa)"/></td>
                                    <td class="text-right">10%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.roa &gt;= 10"><span style="color: #28a745;">✓ Excelente</span></t>
                                        <t t-elif="doc.roa &gt;= 5"><span style="color: #4CAF50;">✓ Bueno</span></t>
                                        <t t-else=""><span style="color: #ff9800;">⚠ Regular</span></t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGE 2: INCOME STATEMENT -->
                    <div class="page-break">
                        <div class="section-title">Análisis del Estado de Resultados</div>

                        <table class="table-compact">
                            <tbody>
                                <tr class="highlight-row">
                                    <td><strong>Ingresos Totales</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 20px;">Costo de Ventas</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.cost_of_goods_sold)"/>)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Ganancia Bruta</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.gross_profit)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Margen Bruto %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.gross_margin)"/></strong></td>
                                </tr>
                                <tr style="height: 2px; background: #ddd;"><td colspan="2"></td></tr>
                                <tr>
                                    <td style="padding-left: 20px;">Gastos Operacionales</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.operating_expenses)"/>)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Ganancia Operacional</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.operating_profit)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Margen Operacional %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.operating_margin)"/></strong></td>
                                </tr>
                                <tr style="height: 2px; background: #ddd;"><td colspan="2"></td></tr>
                                <tr class="highlight-row" style="background-color: #d4edda;">
                                    <td><strong>Ingreso Neto</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.net_income)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Margen Neto %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="analysis-box">
                            <div style="font-weight: bold; margin-bottom: 5px;">💡 Análisis de Rentabilidad</div>
                            <t t-if="doc.net_margin &gt;= 15">
                                ✓ <strong>Excelente Rentabilidad:</strong> Tu empresa genera ganancias excepcionales. El margen neto de <t t-esc="'{:.2f}%'.format(doc.net_margin)"/> está muy por encima del estándar. Continúa con las estrategias actuales.
                            </t>
                            <t t-elif="doc.net_margin &gt;= 8">
                                ✓ <strong>Buena Rentabilidad:</strong> Tu empresa tiene márgenes saludables con <t t-esc="'{:.2f}%'.format(doc.net_margin)"/> de margen neto. Busca oportunidades de optimización operacional.
                            </t>
                            <t t-elif="doc.net_margin &gt;= 2">
                                ⚠ <strong>Rentabilidad Moderada:</strong> Margen neto de <t t-esc="'{:.2f}%'.format(doc.net_margin)"/>. Se recomienda revisar estructura de costos y gastos operacionales.
                            </t>
                            <t t-elif="doc.net_margin &gt;= 0">
                                ⚠ <strong>Rentabilidad Baja:</strong> Margen neto de <t t-esc="'{:.2f}%'.format(doc.net_margin)"/>. Tu empresa apenas genera ganancias. Acción urgente en reducción de costos.
                            </t>
                            <t t-else="">
                                ✗ <strong>Empresa No Rentable:</strong> Margen neto negativo de <t t-esc="'{:.2f}%'.format(doc.net_margin)"/>. La empresa está operando con pérdidas. Se requiere intervención estratégica inmediata en ingresos, COGS y gastos operacionales.
                            </t>
                        </div>
                    </div>

                    <!-- PAGE 3: BALANCE SHEET -->
                    <div class="page-break">
                        <div class="section-title">Análisis del Balance General</div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <h4 style="font-size: 12pt; color: #1a472a; margin-bottom: 6px; border-bottom: 1px solid #1a472a; padding-bottom: 3px;">ACTIVOS</h4>
                                <table class="table-compact" style="margin: 0;">
                                    <tbody>
                                        <tr>
                                            <td>Activos Corrientes</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.current_assets)"/></td>
                                        </tr>
                                        <tr>
                                            <td>Activos Fijos</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.fixed_assets)"/></td>
                                        </tr>
                                        <tr class="highlight-row">
                                            <td><strong>TOTAL ACTIVOS</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_assets)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div>
                                <h4 style="font-size: 12pt; color: #1a472a; margin-bottom: 6px; border-bottom: 1px solid #1a472a; padding-bottom: 3px;">PASIVOS Y PATRIMONIO</h4>
                                <table class="table-compact" style="margin: 0;">
                                    <tbody>
                                        <tr>
                                            <td>Pasivos Corrientes</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.current_liabilities)"/></td>
                                        </tr>
                                        <tr>
                                            <td>Pasivos a Largo Plazo</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.long_term_liabilities)"/></td>
                                        </tr>
                                        <tr class="highlight-row" style="background-color: #ffe8e8;">
                                            <td><strong>Total Pasivos</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_liabilities)"/></strong></td>
                                        </tr>
                                        <tr class="highlight-row" style="background-color: #d4edda;">
                                            <td><strong>Patrimonio Total</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_equity)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="analysis-box">
                            <div style="font-weight: bold; margin-bottom: 5px;">💡 Análisis de Estructura Financiera</div>
                            <strong>Razón Deuda/Patrimonio:</strong> <t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/><br/>
                            <t t-if="doc.debt_to_equity &lt;= 0.5">
                                ✓ <strong>Bajo Endeudamiento:</strong> Estructura financiera muy conservadora. La empresa tiene amplio espacio para endeudamiento si es necesario.
                            </t>
                            <t t-elif="doc.debt_to_equity &lt;= 1.0">
                                ✓ <strong>Endeudamiento Balanceado:</strong> Estructura de capital equilibrada. Relación saludable entre deuda y patrimonio.
                            </t>
                            <t t-else="">
                                ✗ <strong>Alto Endeudamiento:</strong> La deuda supera el patrimonio. Se recomienda estrategia de reducción de deuda.
                            </t>
                        </div>
                    </div>

                    <!-- PAGE 4: FINANCIAL INDICATORS -->
                    <div class="page-break">
                        <div class="section-title">Indicadores Financieros Detallados</div>

                        <t t-foreach="doc.indicator_ids" t-as="indicator">
                            <div class="indicator-card">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div style="flex: 1;">
                                        <div>
                                            <span class="indicator-name"><t t-esc="indicator.name"/></span>
                                            <t t-if="indicator.name == 'ROE'">
                                                <span class="indicator-acronym">ROE</span>
                                            </t>
                                            <t t-elif="indicator.name == 'ROA'">
                                                <span class="indicator-acronym">ROA</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Current Ratio'">
                                                <span class="indicator-acronym">CR</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Quick Ratio'">
                                                <span class="indicator-acronym">QR</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Debt to Equity'">
                                                <span class="indicator-acronym">D/E</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Asset Turnover'">
                                                <span class="indicator-acronym">AT</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Gross Margin'">
                                                <span class="indicator-acronym">GM</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Net Margin'">
                                                <span class="indicator-acronym">NM</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Operating Margin'">
                                                <span class="indicator-acronym">OM</span>
                                            </t>
                                            <t t-elif="indicator.name == 'Interest Coverage'">
                                                <span class="indicator-acronym">IC</span>
                                            </t>
                                        </div>
                                        <div style="font-size: 9pt; color: #666; margin-top: 3px;">
                                            Categoría:
                                            <t t-if="indicator.category == 'profitability'">Rentabilidad</t>
                                            <t t-elif="indicator.category == 'liquidity'">Liquidez</t>
                                            <t t-elif="indicator.category == 'leverage'">Endeudamiento</t>
                                            <t t-elif="indicator.category == 'efficiency'">Eficiencia</t>
                                            <t t-else=""><t t-esc="indicator.category.upper()"/></t>
                                        </div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div class="indicator-value"><t t-esc="'{:.2f}'.format(indicator.value)"/> <t t-esc="indicator.unit or ''"/></div>
                                        <span class="indicator-status" t-attf-class="status-{indicator.status.lower()}">
                                            <t t-if="indicator.status.lower() == 'excellent'">Excelente</t>
                                            <t t-elif="indicator.status.lower() == 'good'">Bueno</t>
                                            <t t-elif="indicator.status.lower() == 'fair'">Regular</t>
                                            <t t-elif="indicator.status.lower() == 'poor'">Deficiente</t>
                                            <t t-else=""><t t-esc="indicator.status.upper()"/></t>
                                        </span>
                                    </div>
                                </div>

                                <!-- Análisis Específico por Indicador -->
                                <div style="font-size: 9.5pt; color: #333; margin-top: 8px; line-height: 1.5; padding: 6px; background-color: #fafafa; border-radius: 3px;">
                                    <strong>¿Qué mide?</strong><br/>
                                    <t t-if="indicator.name == 'ROE'">
                                        Rentabilidad del Patrimonio: Mide cuánta ganancia genera la empresa por cada peso invertido por los accionistas. Un ROE de <t t-esc="'{:.2f}%'.format(indicator.value)"/> significa que por cada $100 de patrimonio, la empresa genera $<t t-esc="'{:.2f}'.format(indicator.value)"/> de ganancia.
                                    </t>
                                    <t t-elif="indicator.name == 'ROA'">
                                        Rentabilidad de Activos: Mide la eficiencia en el uso de activos para generar ganancias. Un ROA de <t t-esc="'{:.2f}%'.format(indicator.value)"/> indica que por cada $100 en activos, se generan $<t t-esc="'{:.2f}'.format(indicator.value)"/> de ganancia.
                                    </t>
                                    <t t-elif="indicator.name == 'Current Ratio'">
                                        Liquidez Corriente: Mide la capacidad de pagar obligaciones a corto plazo. Un ratio de <t t-esc="'{:.2f}'.format(indicator.value)"/> significa que por cada $1 de pasivo corriente, se tienen $<t t-esc="'{:.2f}'.format(indicator.value)"/> en activos corrientes.
                                    </t>
                                    <t t-elif="indicator.name == 'Quick Ratio'">
                                        Prueba Ácida: Liquidez más exigente, excluyendo inventarios. Un ratio de <t t-esc="'{:.2f}'.format(indicator.value)"/> indica disponibilidad inmediata para pagar deudas corrientes.
                                    </t>
                                    <t t-elif="indicator.name == 'Debt to Equity'">
                                        Apalancamiento Financiero: Relación entre deuda y patrimonio. Un índice de <t t-esc="'{:.2f}'.format(indicator.value)"/> significa que por cada $1 de patrimonio, se deben $<t t-esc="'{:.2f}'.format(indicator.value)"/>.
                                    </t>
                                    <t t-elif="indicator.name == 'Asset Turnover'">
                                        Rotación de Activos: Eficiencia en generar ventas con los activos disponibles. Una rotación de <t t-esc="'{:.2f}'.format(indicator.value)"/> veces significa que los activos se "convierten" en ventas <t t-esc="'{:.2f}'.format(indicator.value)"/> veces al año.
                                    </t>
                                    <t t-elif="indicator.name == 'Gross Margin'">
                                        Margen Bruto: Porcentaje de ingresos que queda como ganancia después de costos directos. Un margen de <t t-esc="'{:.2f}%'.format(indicator.value)"/> es bueno para los márgenes operacionales.
                                    </t>
                                    <t t-elif="indicator.name == 'Net Margin'">
                                        Margen Neto: Ganancia final después de todos los costos y gastos. Un margen de <t t-esc="'{:.2f}%'.format(indicator.value)"/> representa la rentabilidad real de la empresa.
                                    </t>
                                    <t t-elif="indicator.name == 'Operating Margin'">
                                        Margen Operacional: Ganancia de operaciones antes de impuestos e intereses. Un margen de <t t-esc="'{:.2f}%'.format(indicator.value)"/> refleja eficiencia operacional.
                                    </t>
                                    <t t-elif="indicator.name == 'Interest Coverage'">
                                        Cobertura de Intereses: Capacidad de pagar intereses de deuda con ganancias operacionales. Un ratio de <t t-esc="'{:.2f}'.format(indicator.value)"/> veces significa que puede cubrir intereses <t t-esc="'{:.2f}'.format(indicator.value)"/> veces.
                                    </t>
                                    <t t-else="">
                                        <t t-esc="indicator.description or 'Indicador financiero especializado'"/>
                                    </t>

                                    <br/><strong style="margin-top: 6px; display: block;">Interpretación:</strong>
                                    <t t-if="indicator.status.lower() == 'excellent'">
                                        ✓ <strong>Desempeño Excelente.</strong> Este indicador muestra fortaleza. Mantén las estrategias actuales.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'good'">
                                        ✓ <strong>Buen Desempeño.</strong> Dentro de rangos normales. Busca pequeñas optimizaciones.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'fair'">
                                        ⚠ <strong>Desempeño Regular.</strong> Por debajo de lo ideal. Requiere atención y mejora.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'poor'">
                                        ✗ <strong>Desempeño Deficiente.</strong> Alerta: este indicador muestra debilidad significativa. Acción urgente recomendada.
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- PAGE 5: RECOMMENDATIONS -->
                    <div class="page-break">
                        <div class="section-title">Recomendaciones y Plan de Acción</div>

                        <t t-if="doc.recommendation_ids">
                            <t t-foreach="doc.recommendation_ids" t-as="rec">
                                <div class="recommendation">
                                    <div style="font-weight: bold; margin-bottom: 6px; font-size: 11pt;">
                                        <t t-esc="rec.name"/>
                                        <span t-attf-style="background-color: {'#dc3545' if rec.priority.lower() == 'high' else '#ff9800' if rec.priority.lower() == 'medium' else '#4CAF50'}; color: white; padding: 2px 7px; border-radius: 2px; font-size: 8.5pt; margin-left: 8px;">
                                            <t t-if="rec.priority.lower() == 'high'">🔴 ALTA PRIORIDAD</t>
                                            <t t-elif="rec.priority.lower() == 'medium'">🟠 PRIORIDAD MEDIA</t>
                                            <t t-elif="rec.priority.lower() == 'low'">🟢 BAJA PRIORIDAD</t>
                                            <t t-else=""><t t-esc="rec.priority.upper()"/></t>
                                        </span>
                                    </div>
                                    <div style="font-size: 9.5pt; line-height: 1.5; margin-bottom: 6px;">
                                        <t t-esc="rec.description or 'No hay descripción disponible'"/>
                                    </div>
                                    <t t-if="rec.roi">
                                        <div style="font-size: 9pt; color: white; font-weight: bold; padding: 5px 8px; background-color: #28a745; border-radius: 3px; display: inline-block;">
                                            📈 ROI Estimado: <t t-esc="'{:.1f}%'.format(rec.roi)"/>
                                        </div>
                                    </t>
                                    <t t-if="rec.estimated_benefit">
                                        <div style="font-size: 9pt; color: #1a472a; margin-top: 4px;">
                                            💰 Beneficio Esperado: <t t-esc="rec.estimated_benefit"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div style="padding: 15px; background-color: #e8f5e9; color: #2e7d32; font-size: 10.5pt; border-radius: 3px; text-align: center;">
                                ✓ No hay recomendaciones en este momento. Tu empresa está operando dentro de los parámetros esperados.
                            </div>
                        </t>
                    </div>

                    <!-- PAGE 6: FOOTER/SUMMARY -->
                    <div class="page-break">
                        <div class="report-header" style="margin-bottom: 20px;">
                            <div style="font-size: 16pt; font-weight: bold;">Resumen Ejecutivo del Análisis</div>
                        </div>

                        <div style="margin-bottom: 15px;">
                            <h4 style="color: #1a472a; font-size: 12pt; margin-bottom: 8px;">Salud Financiera General: <t t-esc="doc.overall_health"/></h4>
                            <div style="font-size: 10pt; line-height: 1.6; background-color: #f9f9f9; padding: 12px; border-left: 4px solid #1a472a; border-radius: 3px;">
                                <t t-if="doc.health_score &gt;= 80">
                                    ✓ <strong>Excelente Salud Financiera.</strong> Tu empresa demuestra solidez financiera con indicadores sólidos en rentabilidad, liquidez y estructura de capital. Mantén las estrategias actuales mientras exploras oportunidades de crecimiento estratégico.
                                </t>
                                <t t-elif="doc.health_score &gt;= 60">
                                    ✓ <strong>Buena Salud Financiera.</strong> Tu empresa está en posición financiera sólida. Enfócate en mejorar indicadores con puntuaciones más bajas. Implementa las acciones recomendadas para fortalecer aún más el desempeño.
                                </t>
                                <t t-elif="doc.health_score &gt;= 40">
                                    ⚠ <strong>Salud Financiera Moderada.</strong> Tu empresa requiere atención en varias áreas. Aborda las debilidades clave identificadas. Prioriza las recomendaciones marcadas como ALTA PRIORIDAD.
                                </t>
                                <t t-else="">
                                    ✗ <strong>Salud Financiera Crítica.</strong> Tu empresa enfrenta desafíos financieros significativos. Se requiere plan de acción inmediato. Considera consultoría especializada para intervención estratégica.
                                </t>
                            </div>
                        </div>

                        <div style="margin-top: 15px; padding: 12px; background-color: #f0f8f4; border-left: 3px solid #28a745; border-radius: 3px; font-size: 9.5pt; line-height: 1.6;">
                            <strong>Próximos Pasos Recomendados:</strong>
                            <t t-if="doc.health_score &gt;= 80">
                                1) Mantener vigilancia periódica de indicadores clave
                                2) Explorar oportunidades de diversificación o expansión
                                3) Optimizar estructura tributaria y financiera
                            </t>
                            <t t-elif="doc.health_score &gt;= 60">
                                1) Implementar las recomendaciones de mejora identificadas
                                2) Revisar estructura de costos y gastos operacionales
                                3) Realizar análisis trimestral de desempeño
                            </t>
                            <t t-elif="doc.health_score &gt;= 40">
                                1) Implementar TODAS las recomendaciones de ALTA PRIORIDAD
                                2) Desarrollar plan de mejora operacional integral
                                3) Realizar seguimiento mensual del desempeño
                            </t>
                            <t t-else="">
                                1) Activar plan de recuperación financiera urgente
                                2) Consultar con asesor financiero especializado
                                3) Reestructuración de costos, deuda y operaciones
                                4) Seguimiento semanal de indicadores críticos
                            </t>
                        </div>

                        <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #1a472a; font-size: 9pt; color: #666;">
                            <div><strong>Reporte Generado:</strong> <t t-esc="doc.analysis_date.strftime('%d/%m/%Y %H:%M')"/></div>
                            <div><strong>Empresa:</strong> <t t-esc="doc.company_id.name"/></div>
                            <div><strong>Período Analizado:</strong> <t t-esc="doc.start_date.strftime('%d/%m/%Y')"/> al <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/></div>
                            <div><strong>Tipo de Análisis:</strong>
                                <t t-if="doc.analysis_type == 'monthly'">Mensual</t>
                                <t t-elif="doc.analysis_type == 'quarterly'">Trimestral</t>
                                <t t-elif="doc.analysis_type == 'semiannual'">Semestral</t>
                                <t t-elif="doc.analysis_type == 'annual'">Anual</t>
                                <t t-else=""><t t-esc="doc.analysis_type.title()"/></t>
                            </div>
                            <div style="margin-top: 12px; font-style: italic; font-size: 8.5pt;">
                                Este reporte proporciona un análisis financiero integral basado en datos auditados. Las recomendaciones se basan en indicadores calculados según estándares financieros internacionales (IFRS). Se recomienda validar con un asesor financiero profesional.
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_financial_analysis_report" model="ir.actions.report">
            <field name="name">Financial Analysis Report</field>
            <field name="model">financial.analysis</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_analysis.financial_analysis_report_template</field>
            <field name="print_report_name">'Financial Analysis Report - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
