<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financial Analysis Report Template - Redesigned -->
        <template id="financial_analysis_report_template">
            <t t-call="web.html_container">
                <t t-set="doc" t-value="docs[0]"/>
                <div class="article o_report_layout_standard" style="font-size: 11pt; line-height: 1.4; margin: 0; padding: 0;">
                    <style>
                        .report-header { background-color: #1a472a; color: white; padding: 15px; margin: -15px -15px 0 -15px; }
                        .report-title { font-size: 24pt; font-weight: bold; margin: 0; }
                        .report-subtitle { font-size: 13pt; opacity: 0.9; margin-top: 3px; }
                        .report-company { font-size: 12pt; margin-top: 8px; }

                        .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 10px 0; }
                        .metric-item { background-color: #f0f0f0; padding: 6px 8px; border-left: 3px solid #1a472a; }
                        .metric-label { font-size: 10pt; color: #666; }
                        .metric-value { font-size: 12pt; font-weight: bold; color: #000; }

                        .section-title { font-size: 14pt; font-weight: bold; color: #1a472a; margin-top: 12px; margin-bottom: 6px; border-bottom: 2px solid #1a472a; padding-bottom: 4px; }

                        .table-compact { width: 100%; border-collapse: collapse; font-size: 10.5pt; margin: 8px 0; }
                        .table-compact th { background-color: #2a5a40; color: white; padding: 5px 6px; text-align: left; font-weight: bold; border: none; }
                        .table-compact td { padding: 4px 6px; border-bottom: 1px solid #ddd; }
                        .table-compact tr:nth-child(even) { background-color: #f9f9f9; }
                        .table-compact tr:hover { background-color: #f0f0f0; }

                        .text-right { text-align: right; }
                        .text-center { text-align: center; }

                        .highlight-row { background-color: #e8f4f0; font-weight: bold; }
                        .highlight-positive { color: #28a745; }
                        .highlight-negative { color: #dc3545; }

                        .key-metric-box { display: inline-block; background: linear-gradient(135deg, #1a472a 0%, #2a5a40 100%); color: white; padding: 8px 12px; margin: 4px 2px; border-radius: 4px; text-align: center; min-width: 120px; }
                        .key-metric-box-label { font-size: 9pt; opacity: 0.9; }
                        .key-metric-box-value { font-size: 13pt; font-weight: bold; }

                        .indicator-card { background-color: #f8f9fa; border-left: 4px solid #1a472a; padding: 8px; margin: 6px 0; }
                        .indicator-name { font-size: 11pt; font-weight: bold; color: #000; }
                        .indicator-value { font-size: 13pt; color: #1a472a; font-weight: bold; }
                        .indicator-status { font-size: 9pt; display: inline-block; padding: 2px 6px; border-radius: 3px; margin-left: 5px; }
                        .status-excellent { background-color: #28a745; color: white; }
                        .status-good { background-color: #4CAF50; color: white; }
                        .status-fair { background-color: #ff9800; color: white; }
                        .status-poor { background-color: #dc3545; color: white; }

                        .page-break { page-break-after: always; padding-bottom: 20px; }

                        .recommendation { background-color: #e8f4f0; border-left: 3px solid #1a472a; padding: 6px 8px; margin: 4px 0; font-size: 10.5pt; }

                        h1, h2, h3, h4, h5 { margin: 0; padding: 0; }
                    </style>

                    <!-- PAGE 1: HEADER & DASHBOARD -->
                    <div class="page-break">
                        <div class="report-header">
                            <div class="report-title"><t t-esc="doc.name"/></div>
                            <div class="report-company"><t t-esc="doc.company_id.name"/></div>
                            <div class="report-subtitle">Financial Analysis Report</div>
                        </div>

                        <div class="metrics-grid" style="margin-top: 15px;">
                            <div class="metric-item">
                                <div class="metric-label">Period</div>
                                <div class="metric-value"><t t-esc="doc.start_date.strftime('%d/%m/%Y')"/> to <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/></div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Overall Health</div>
                                <div class="metric-value"><t t-esc="doc.overall_health"/> (<t t-esc="'{:.0f}'.format(doc.health_score)"/>/100)</div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Analysis Type</div>
                                <div class="metric-value"><t t-esc="doc.analysis_type.title()"/></div>
                            </div>
                            <div class="metric-item">
                                <div class="metric-label">Analysis Date</div>
                                <div class="metric-value"><t t-esc="doc.analysis_date.strftime('%d/%m/%Y')"/></div>
                            </div>
                        </div>

                        <div class="section-title" style="margin-top: 20px;">Key Financial Highlights</div>
                        <div style="margin: 10px 0;">
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Total Revenue</div>
                                <div class="key-metric-box-value"><t t-esc="'{:,.0f}'.format(doc.total_revenue)"/></div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Net Income</div>
                                <div class="key-metric-box-value" t-attf-style="color: {('white' if doc.net_income > 0 else '#ff6b6b')};">
                                    <t t-esc="'{:,.0f}'.format(doc.net_income)"/>
                                </div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">Net Margin</div>
                                <div class="key-metric-box-value"><t t-esc="'{:.1f}%'.format(doc.net_margin)"/></div>
                            </div>
                            <div class="key-metric-box">
                                <div class="key-metric-box-label">ROE</div>
                                <div class="key-metric-box-value"><t t-esc="'{:.1f}%'.format(doc.roe)"/></div>
                            </div>
                        </div>

                        <div class="section-title" style="margin-top: 20px;">Executive Summary - Key Metrics</div>
                        <table class="table-compact">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-right">Value</th>
                                    <th class="text-right">Benchmark</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="highlight-row">
                                    <td><strong>Total Revenue</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_revenue)"/></strong></td>
                                    <td class="text-right">—</td>
                                    <td class="text-center">✓</td>
                                </tr>
                                <tr>
                                    <td>Net Margin %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></td>
                                    <td class="text-right">15%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.net_margin &gt;= 15"><span style="color: #28a745;">Excellent</span></t>
                                        <t t-elif="doc.net_margin &gt;= 8"><span style="color: #4CAF50;">Good</span></t>
                                        <t t-elif="doc.net_margin &gt;= 2"><span style="color: #ff9800;">Fair</span></t>
                                        <t t-else=""><span style="color: #dc3545;">Poor</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Current Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.current_ratio)"/></td>
                                    <td class="text-right">1.5+</td>
                                    <td class="text-center">
                                        <t t-if="doc.current_ratio &gt;= 1.5"><span style="color: #28a745;">Good</span></t>
                                        <t t-elif="doc.current_ratio &gt;= 1"><span style="color: #ff9800;">Adequate</span></t>
                                        <t t-else=""><span style="color: #dc3545;">Risk</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Debt/Equity Ratio</td>
                                    <td class="text-right"><t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/></td>
                                    <td class="text-right">&lt; 1.0</td>
                                    <td class="text-center">
                                        <t t-if="doc.debt_to_equity &lt;= 0.5"><span style="color: #28a745;">Low</span></t>
                                        <t t-elif="doc.debt_to_equity &lt;= 1.0"><span style="color: #4CAF50;">Balanced</span></t>
                                        <t t-else=""><span style="color: #dc3545;">High</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROE %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roe)"/></td>
                                    <td class="text-right">20%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.roe &gt;= 20"><span style="color: #28a745;">Excellent</span></t>
                                        <t t-elif="doc.roe &gt;= 10"><span style="color: #4CAF50;">Good</span></t>
                                        <t t-else=""><span style="color: #ff9800;">Fair</span></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td>ROA %</td>
                                    <td class="text-right"><t t-esc="'{:.2f}%'.format(doc.roa)"/></td>
                                    <td class="text-right">10%+</td>
                                    <td class="text-center">
                                        <t t-if="doc.roa &gt;= 10"><span style="color: #28a745;">Excellent</span></t>
                                        <t t-elif="doc.roa &gt;= 5"><span style="color: #4CAF50;">Good</span></t>
                                        <t t-else=""><span style="color: #ff9800;">Fair</span></t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGE 2: INCOME STATEMENT -->
                    <div class="page-break">
                        <div class="section-title">Análisis del Estado de Resultados</div>

                        <table class="table-compact">
                            <tbody>
                                <tr class="highlight-row">
                                    <td><strong>Total Revenue</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.total_revenue)"/></strong></td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 20px;">Cost of Goods Sold</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.cost_of_goods_sold)"/>)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Gross Profit</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.gross_profit)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Gross Margin %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.gross_margin)"/></strong></td>
                                </tr>
                                <tr style="height: 2px; background: #ddd;"><td colspan="2"></td></tr>
                                <tr>
                                    <td style="padding-left: 20px;">Operating Expenses</td>
                                    <td class="text-right">(<t t-esc="'{:,.2f}'.format(doc.operating_expenses)"/>)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Operating Profit</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.operating_profit)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Operating Margin %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.operating_margin)"/></strong></td>
                                </tr>
                                <tr style="height: 2px; background: #ddd;"><td colspan="2"></td></tr>
                                <tr class="highlight-row" style="background-color: #d4edda;">
                                    <td><strong>Net Income</strong></td>
                                    <td class="text-right"><strong><t t-esc="'{:,.2f}'.format(doc.net_income)"/></strong></td>
                                </tr>
                                <tr>
                                    <td>Net Margin %</td>
                                    <td class="text-right"><strong><t t-esc="'{:.2f}%'.format(doc.net_margin)"/></strong></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top: 15px; padding: 10px; background-color: #f0f8f4; border-left: 3px solid #28a745;">
                            <div style="font-weight: bold; font-size: 11pt; margin-bottom: 5px;">💡 Análisis de Rentabilidad</div>
                            <div style="font-size: 10pt; line-height: 1.5;">
                                <t t-if="doc.net_margin &gt;= 15">
                                    Tu empresa muestra excelente rentabilidad con márgenes netos sólidos. Continúa optimizando costos mientras mantienes la calidad.
                                </t>
                                <t t-elif="doc.net_margin &gt;= 8">
                                    Buen desempeño de rentabilidad. Enfócate en reducir gastos operacionales y mejorar márgenes brutos.
                                </t>
                                <t t-elif="doc.net_margin &gt;= 2">
                                    La rentabilidad es modesta. Implementa estrategias de reducción de costos y revisa precios.
                                </t>
                                <t t-else="">
                                    Baja rentabilidad. Se requiere acción urgente para reducir costos y/o aumentar ingresos.
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- PAGE 3: BALANCE SHEET -->
                    <div class="page-break">
                        <div class="section-title">Análisis del Balance General</div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <!-- ASSETS -->
                            <div>
                                <h4 style="font-size: 12pt; color: #1a472a; margin-bottom: 6px; border-bottom: 1px solid #1a472a; padding-bottom: 3px;">ASSETS</h4>
                                <table class="table-compact" style="margin: 0;">
                                    <tbody>
                                        <tr>
                                            <td>Current Assets</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.current_assets)"/></td>
                                        </tr>
                                        <tr>
                                            <td>Fixed Assets</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.fixed_assets)"/></td>
                                        </tr>
                                        <tr class="highlight-row">
                                            <td><strong>TOTAL ASSETS</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_assets)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- LIABILITIES & EQUITY -->
                            <div>
                                <h4 style="font-size: 12pt; color: #1a472a; margin-bottom: 6px; border-bottom: 1px solid #1a472a; padding-bottom: 3px;">LIABILITIES &amp; EQUITY</h4>
                                <table class="table-compact" style="margin: 0;">
                                    <tbody>
                                        <tr>
                                            <td>Current Liabilities</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.current_liabilities)"/></td>
                                        </tr>
                                        <tr>
                                            <td>Long Term Liabilities</td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(doc.long_term_liabilities)"/></td>
                                        </tr>
                                        <tr class="highlight-row" style="background-color: #ffe8e8;">
                                            <td><strong>Total Liabilities</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_liabilities)"/></strong></td>
                                        </tr>
                                        <tr class="highlight-row" style="background-color: #d4edda;">
                                            <td><strong>Total Equity</strong></td>
                                            <td class="text-right"><strong><t t-esc="'{:,.0f}'.format(doc.total_equity)"/></strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div style="margin-top: 15px; padding: 10px; background-color: #f0f8f4; border-left: 3px solid #28a745;">
                            <div style="font-weight: bold; font-size: 11pt; margin-bottom: 5px;">💡 Análisis del Balance General</div>
                            <div style="font-size: 10pt; line-height: 1.5;">
                                <strong>Razón Deuda/Patrimonio:</strong> <t t-esc="'{:.2f}'.format(doc.debt_to_equity)"/>
                                <t t-if="doc.debt_to_equity &lt;= 0.5">
                                    - Bajo endeudamiento con estructura de financiamiento conservadora.
                                </t>
                                <t t-elif="doc.debt_to_equity &lt;= 1.0">
                                    - Estructura de capital equilibrada con niveles de deuda moderados.
                                </t>
                                <t t-else="">
                                    - Posición de alto endeudamiento. Considera estrategias de reducción de deuda.
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- PAGE 4: FINANCIAL INDICATORS -->
                    <div class="page-break">
                        <div class="section-title">Indicadores Financieros</div>

                        <t t-foreach="doc.indicator_ids" t-as="indicator">
                            <div class="indicator-card">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <div class="indicator-name"><t t-esc="indicator.name"/></div>
                                        <div style="font-size: 9pt; color: #666; margin-top: 2px;">
                                            Categoría:
                                            <t t-if="indicator.category == 'profitability'">Rentabilidad</t>
                                            <t t-elif="indicator.category == 'liquidity'">Liquidez</t>
                                            <t t-elif="indicator.category == 'leverage'">Endeudamiento</t>
                                            <t t-elif="indicator.category == 'efficiency'">Eficiencia</t>
                                            <t t-else=""><t t-esc="indicator.category.upper()"/></t>
                                        </div>
                                    </div>
                                    <div style="text-align: right;">
                                        <div class="indicator-value"><t t-esc="'{:.2f}'.format(indicator.value)"/> <t t-esc="indicator.unit or ''"/></div>
                                        <span class="indicator-status" t-attf-class="status-{indicator.status.lower()}">
                                            <t t-if="indicator.status.lower() == 'excellent'">Excelente</t>
                                            <t t-elif="indicator.status.lower() == 'good'">Bueno</t>
                                            <t t-elif="indicator.status.lower() == 'fair'">Regular</t>
                                            <t t-elif="indicator.status.lower() == 'poor'">Deficiente</t>
                                            <t t-else=""><t t-esc="indicator.status.upper()"/></t>
                                        </span>
                                    </div>
                                </div>
                                <div style="font-size: 9.5pt; color: #555; margin-top: 6px; line-height: 1.5; padding: 6px; background-color: #fafafa; border-radius: 3px;">
                                    <strong>¿Qué mide?</strong>
                                    <t t-if="indicator.category == 'profitability'">
                                        Este indicador mide la capacidad de tu empresa para generar ganancias a partir de sus operaciones y ventas.
                                    </t>
                                    <t t-elif="indicator.category == 'liquidity'">
                                        Este indicador mide la capacidad de tu empresa para pagar sus obligaciones a corto plazo con sus activos disponibles.
                                    </t>
                                    <t t-elif="indicator.category == 'leverage'">
                                        Este indicador mide el nivel de endeudamiento y la estructura de financiamiento de tu empresa.
                                    </t>
                                    <t t-elif="indicator.category == 'efficiency'">
                                        Este indicador mide la eficiencia con la que tu empresa utiliza sus activos para generar ventas.
                                    </t>
                                    <t t-else="">
                                        <t t-esc="indicator.description or 'No hay descripción disponible'"/>
                                    </t>
                                    <br/>
                                    <strong style="margin-top: 4px; display: block;">Interpretación:</strong>
                                    <t t-if="indicator.status.lower() == 'excellent'">
                                        Excelente desempeño. Tu empresa está operando de manera óptima en esta área. Mantén las estrategias actuales.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'good'">
                                        Buen desempeño. Tu empresa está funcionando bien en esta área. Busca oportunidades para mejorar aún más.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'fair'">
                                        Desempeño regular. Hay oportunidades de mejora en esta área. Implementa cambios para aumentar el valor.
                                    </t>
                                    <t t-elif="indicator.status.lower() == 'poor'">
                                        Desempeño deficiente. Se requiere acción urgente para mejorar en esta área. Revisa la sección de recomendaciones.
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- PAGE 5: RECOMMENDATIONS -->
                    <div class="page-break">
                        <div class="section-title">Recomendaciones y Plan de Acción</div>

                        <t t-if="doc.recommendation_ids">
                            <t t-foreach="doc.recommendation_ids" t-as="rec">
                                <div class="recommendation">
                                    <div style="font-weight: bold; margin-bottom: 5px; font-size: 10.5pt;">
                                        <t t-esc="rec.name"/>
                                        <span t-attf-style="background-color: {'#dc3545' if rec.priority.lower() == 'high' else '#ff9800' if rec.priority.lower() == 'medium' else '#4CAF50'}; color: white; padding: 2px 6px; border-radius: 2px; font-size: 8pt; margin-left: 6px;">
                                            <t t-if="rec.priority.lower() == 'high'">ALTA PRIORIDAD</t>
                                            <t t-elif="rec.priority.lower() == 'medium'">PRIORIDAD MEDIA</t>
                                            <t t-elif="rec.priority.lower() == 'low'">BAJA PRIORIDAD</t>
                                            <t t-else=""><t t-esc="rec.priority.upper()"/></t>
                                        </span>
                                    </div>
                                    <div style="font-size: 9.5pt; line-height: 1.5; margin-bottom: 6px;">
                                        <t t-esc="rec.description or 'No hay descripción disponible'"/>
                                    </div>
                                    <t t-if="rec.roi">
                                        <div style="font-size: 9pt; color: #28a745; font-weight: bold; margin-top: 4px; padding: 4px 6px; background-color: #e8f5e9; border-radius: 3px;">
                                            📈 ROI Estimado: <t t-esc="'{:.1f}%'.format(rec.roi)"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div style="padding: 15px; background-color: #f0f0f0; color: #666; font-size: 10pt; border-radius: 3px; text-align: center;">
                                No hay recomendaciones en este momento. Tu empresa está funcionando bien.
                            </div>
                        </t>
                    </div>

                    <!-- PAGE 6: FOOTER/SUMMARY -->
                    <div class="page-break">
                        <div class="report-header" style="margin-bottom: 20px;">
                            <div style="font-size: 16pt; font-weight: bold;">Resumen del Análisis</div>
                        </div>

                        <div style="margin-bottom: 15px;">
                            <h4 style="color: #1a472a; font-size: 12pt; margin-bottom: 8px;">Salud Financiera General: <t t-esc="doc.overall_health"/></h4>
                            <div style="font-size: 10pt; line-height: 1.6; background-color: #f9f9f9; padding: 10px; border-left: 3px solid #1a472a;">
                                <t t-if="doc.health_score &gt;= 80">
                                    Tu empresa demuestra excelente salud financiera con indicadores sólidos en rentabilidad, liquidez y endeudamiento. Mantén las estrategias actuales mientras exploras oportunidades de crecimiento.
                                </t>
                                <t t-elif="doc.health_score &gt;= 60">
                                    Buena posición financiera general. Enfócate en mejorar áreas con puntuaciones más bajas. Implementa las acciones recomendadas para fortalecer el desempeño financiero.
                                </t>
                                <t t-elif="doc.health_score &gt;= 40">
                                    Salud financiera moderada. Aborda las debilidades clave identificadas en el análisis. Prioriza las recomendaciones marcadas como ALTA PRIORIDAD.
                                </t>
                                <t t-else="">
                                    La salud financiera requiere atención. Implementa un plan de acción urgente. Consulta con asesores financieros para mejoras estratégicas.
                                </t>
                            </div>
                        </div>

                        <div style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #1a472a; font-size: 9pt; color: #666;">
                            <div>Reporte Generado: <t t-esc="doc.analysis_date.strftime('%d/%m/%Y %H:%M')"/></div>
                            <div>Empresa: <t t-esc="doc.company_id.name"/></div>
                            <div>Tipo de Análisis:
                                <t t-if="doc.analysis_type == 'monthly'">Mensual</t>
                                <t t-elif="doc.analysis_type == 'quarterly'">Trimestral</t>
                                <t t-elif="doc.analysis_type == 'semiannual'">Semestral</t>
                                <t t-elif="doc.analysis_type == 'annual'">Anual</t>
                                <t t-else=""><t t-esc="doc.analysis_type.title()"/></t>
                            </div>
                            <div style="margin-top: 10px; font-style: italic;">
                                Este reporte proporciona un análisis financiero integral basado en datos del <t t-esc="doc.start_date.strftime('%d/%m/%Y')"/> al <t t-esc="doc.end_date.strftime('%d/%m/%Y')"/>.
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Report Action -->
        <record id="action_financial_analysis_report" model="ir.actions.report">
            <field name="name">Financial Analysis Report</field>
            <field name="model">financial.analysis</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">financial_analysis.financial_analysis_report_template</field>
            <field name="print_report_name">'Financial Analysis Report - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
