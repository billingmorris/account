<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dashboard View (Board) -->
        <record id="financial_analysis_dashboard" model="ir.ui.view">
            <field name="name">financial.analysis.dashboard</field>
            <field name="model">financial.analysis</field>
            <field name="type">dashboard</field>
            <field name="arch" type="xml">
                <dashboard>
                    <view type="graph" ref="financial_analysis_revenue_graph"/>
                    <view type="graph" ref="financial_analysis_profit_graph"/>
                    <view type="graph" ref="financial_analysis_ratio_graph"/>
                </dashboard>
            </field>
        </record>

        <!-- Financial Analysis Revenue Graph -->
        <record id="financial_analysis_revenue_graph" model="ir.ui.view">
            <field name="name">financial.analysis.revenue.graph</field>
            <field name="model">financial.analysis</field>
            <field name="arch" type="xml">
                <graph string="Revenue Trend" type="line">
                    <field name="analysis_date" type="row"/>
                    <field name="total_revenue" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Financial Analysis Profit Graph -->
        <record id="financial_analysis_profit_graph" model="ir.ui.view">
            <field name="name">financial.analysis.profit.graph</field>
            <field name="model">financial.analysis</field>
            <field name="arch" type="xml">
                <graph string="Profitability Analysis" type="bar">
                    <field name="analysis_date" type="row"/>
                    <field name="gross_profit" type="measure"/>
                    <field name="operating_profit" type="measure"/>
                    <field name="net_income" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Financial Analysis Ratio Graph -->
        <record id="financial_analysis_ratio_graph" model="ir.ui.view">
            <field name="name">financial.analysis.ratio.graph</field>
            <field name="model">financial.analysis</field>
            <field name="arch" type="xml">
                <graph string="Key Ratios" type="line">
                    <field name="analysis_date" type="row"/>
                    <field name="roe" type="measure"/>
                    <field name="roa" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Financial Health Dashboard -->
        <record id="financial_health_dashboard_action" model="ir.actions.act_window">
            <field name="name">Financial Health Dashboard</field>
            <field name="res_model">financial.analysis</field>
            <field name="view_mode">dashboard,tree,form</field>
            <field name="view_id" ref="financial_analysis_dashboard"/>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
